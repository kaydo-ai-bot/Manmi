# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ====================================================
# CONFIGURATION PROPRIÉTAIRE (OWNER) & IDENTITÉ DU BOT
# ====================================================
# Numéro WhatsApp officiel du propriétaire exclusif (avec indicatif, sans + ni espaces)
OWNER_1=50935975863
OWNER_NUMBERS=50935975863
# Nom officiel du bot
BOT_NAME="🥷 𝑩𝒁𝑲 𝑩𝑶𝑻 🌪️"

# ====================================================
# INFRASTRUCTURE 24/7 PRODUCTION CONFIGURATION
# ====================================================
# Port d'écoute du serveur (par défaut: 3000)
PORT=3000

# Environnement d'exécution (production ou development)
NODE_ENV=production

# ====================================================
# STOCKAGE PERSISTANT EXTERNE (INDISPENSABLE POUR RENDER FREE)
# ====================================================
# URL de connexion PostgreSQL externe (ex: Render PostgreSQL, Supabase, Neon).
# Permet de restaurer automatiquement toutes les sessions WhatsApp même après redémarrage ou recréation du conteneur.
DATABASE_URL=

# Cache local / Fallback local (filesystem temporaire du conteneur)
SESSIONS_DIR=/app/sessions
SESSIONS_BACKUP_DIR=/app/sessions_backup

# ====================================================
# MULTI-SESSION CONCURRENCY & LIMITS (UP TO 100 SESSIONS)
# ====================================================
# Nombre de sessions initialisées en parallèle au boot
SESSION_START_CONCURRENCY=10

# Limite de téléchargements multimédia simultanés (.song, .video, ffmpeg)
DOWNLOAD_CONCURRENCY=8

# Limite de transactions PostgreSQL concurrentes
DATABASE_CONCURRENCY=15

# Limite d'appels API externes concurrents
API_CONCURRENCY=20

# ====================================================
# CODE SECRET DU PANNEAU ADMINISTRATEUR
# ====================================================
# Code secret personnel pour déverrouiller l'accès complet à l'espace administrateur / sessions
ADMIN_SECRET_KEY=KAYDO2026
ADMIN_PASSCODE=50935975863

# Telegram Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=

# TGS Downloader & Converter Configuration
TGS_BATCH_SIZE=20
TGS_CONCURRENCY=3
TGS_TIMEOUT_MS=120000
TGS_MAX_SIZE_MB=20
TGS_TEMP_DIR=/tmp/kaydo-tgs

